{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos SOLO del webview de la interfaz (label `main`). Los webviews de servicios (svc-*) cargan webs de terceros y no reciben ningún permiso IPC.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-list-services",
    "allow-sync-layout",
    "allow-add-service",
    "allow-update-service",
    "allow-reorder-services",
    "allow-remove-service",
    "allow-reload-service",
    "allow-go-home-service",
    "allow-open-in-browser",
    "allow-unread-counts",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-rename-workspace",
    "allow-delete-workspace",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-focus",
    "allow-set-service-icon",
    "allow-list-notifications",
    "allow-clear-notifications",
    "allow-hibernate-service",
    "allow-list-hibernated",
    "allow-lock-status",
    "allow-lock-now",
    "allow-unlock",
    "allow-set-pin",
    "allow-export-config",
    "allow-import-config",
    "allow-refresh-service-icon",
    "allow-service-memory",
    "allow-extensions-info",
    "allow-open-extensions-folder",
    "allow-reload-extensions",
    "allow-sync-suggestions",
    "allow-set-sync-folder",
    "allow-sync-now",
    "allow-list-tasks",
    "allow-add-task",
    "allow-set-task-done",
    "allow-delete-task",
    "allow-clear-done-tasks"
  ]
}
